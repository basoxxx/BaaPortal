// Logica a parola e a doppia parola: AW, OW, XOW, AD, OD, XOD, con e senza costante.
// atteso: MW0=16#00F0, MW2=16#0FFF, MW4=16#0F0F, MW6=16#0F00, MW8=16#FFF0, MW10=16#F0F0
// atteso: MD12=16#F000F000, MD16=16#00F000F0, MD20=16#FFF0FFF0, MD24=16#0F0FF0F0
// atteso: MD28=16#FFF0FFF0, MD32=16#0F0FF0F0
//@ block OB 1
	L W#16#0FF0;
	L W#16#00FF;
	AW;
	T MW 0;
	L W#16#0FF0;
	L W#16#00FF;
	OW;
	T MW 2;
	L W#16#0FF0;
	L W#16#00FF;
	XOW;
	T MW 4;
	L W#16#FF00;
	AW W#16#0FF0;
	T MW 6;
	L W#16#FF00;
	OW W#16#0FF0;
	T MW 8;
	L W#16#FF00;
	XOW W#16#0FF0;
	T MW 10;
//@ network
	L DW#16#F0F0F0F0;
	AD DW#16#FF00FF00;
	T MD 12;
	L DW#16#F0F0F0F0;
	L DW#16#0FF00FF0;
	AD;
	T MD 16;
	L DW#16#F0F0F0F0;
	OD DW#16#0FF00FF0;
	T MD 20;
	L DW#16#F0F0F0F0;
	XOD DW#16#FFFF0000;
	T MD 24;
	L DW#16#F0F0F0F0;
	L DW#16#0FF00FF0;
	OD;
	T MD 28;
	L DW#16#F0F0F0F0;
	L DW#16#FFFF0000;
	XOD;
	T MD 32;
