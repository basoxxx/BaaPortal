// Salti: JU, JC, JCN, JCB, JNB, JBI, JNBI, JO, JOS, JZ, JN, JP, JM, JPZ, JMZ, JUO, JL, LOOP.
// Ogni bit M è messo a 1 solo se il salto sopra di lui NON è stato fatto.
// atteso: MB0=16#14, MB1=2, MB2=16#F8, MB3=4, MB4=8, MB5=12, MB6=0, MD70=16#7FC00000
// atteso: MW20=5, MB22=12
//@ block OB 1
	JU a1;
	SET;
	= M 0.0;
a1:	SET;
	JC a2;
	SET;
	= M 0.1;
a2:	CLR;
	JC a3;
	SET;
	= M 0.2;
a3:	CLR;
	JCN a4;
	SET;
	= M 0.3;
a4:	SET;
	JCN a5;
	SET;
	= M 0.4;
a5:	SET;
	JCB a6;
	SET;
	= M 0.5;
a6:	CLR;
	JNB a7;
	SET;
	= M 0.6;
a7:	SET;
	SAVE;
	JBI a8;
	SET;
	= M 0.7;
a8:	CLR;
	SAVE;
	JNBI a9;
	SET;
	= M 1.0;
a9:	SET;
	SAVE;
	JNBI a10;
	SET;
	= M 1.1;
a10:	NOP 0;
//@ network
	L 3;
	L 5;
	-I;
	JM b1;
	SET;
	= M 2.0;
b1:	JMZ b2;
	SET;
	= M 2.1;
b2:	JN b3;
	SET;
	= M 2.2;
b3:	JP b4;
	SET;
	= M 2.3;
b4:	JPZ b5;
	SET;
	= M 2.4;
b5:	JZ b6;
	SET;
	= M 2.5;
b6:	JUO b7;
	SET;
	= M 2.6;
b7:	JO b8;
	SET;
	= M 2.7;
b8:	NOP 0;
//@ network
	L 32767;
	L 1;
	+I;
	JO c1;
	SET;
	= M 3.0;
c1:	JOS c2;
	SET;
	= M 3.1;
c2:	JOS c3;
	SET;
	= M 3.2;
c3:	NOP 0;
//@ network
	L 5;
	L 5;
	-I;
	JZ d1;
	SET;
	= M 4.0;
d1:	JPZ d2;
	SET;
	= M 4.1;
d2:	JMZ d3;
	SET;
	= M 4.2;
d3:	JP d4;
	SET;
	= M 4.3;
d4:	NOP 0;
//@ network
	L 9;
	L 3;
	-I;
	JP e1;
	SET;
	= M 5.0;
e1:	JPZ e2;
	SET;
	= M 5.1;
e2:	JMZ e3;
	SET;
	= M 5.2;
e3:	JM e4;
	SET;
	= M 5.3;
e4:	JN e5;
	SET;
	= M 5.4;
e5:	NOP 0;
//@ network
	L 0.0;
	L 0.0;
	/R;
	T MD 70;
	JUO f1;
	SET;
	= M 6.0;
f1:	NOP 0;
//@ network
	L 5;
g1:	T MW 10;
	L MW 20;
	L 1;
	+I;
	T MW 20;
	L MW 10;
	LOOP g1;
//@ network
	L 2;
	JL j9;
	JU j0;
	JU j1;
	JU j2;
j9:	JU jd;
j0:	L 10;
	T MB 22;
	JU jx;
j1:	L 11;
	T MB 22;
	JU jx;
j2:	L 12;
	T MB 22;
	JU jx;
jd:	L 99;
	T MB 22;
jx:	NOP 0;
