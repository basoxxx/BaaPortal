// Logica a bit: A, AN, O, ON, X, XN, =, S, R, NOT, SET, CLR, FP, FN, SAVE.
// Esempi nello stile del manuale AWL («Operazioni logiche a bit»).
// atteso: MB0=16#5D, MB1=2, MB2=5, MB10=1
// imposta: M10.1=1
// atteso: RLO=0, STA=0, OR=0, FC=0, BR=1
//@ block OB 1
	SET;
	= M 0.0;
	CLR;
	= M 0.1;
	A M 0.0;
	AN M 0.1;
	= M 0.2;
	A M 0.0;
	A M 0.1;
	O M 0.0;
	= M 0.3;
	O M 0.1;
	ON M 0.1;
	= M 0.4;
	X M 0.0;
	X M 0.2;
	= M 0.5;
	XN M 0.0;
	XN M 0.1;
	= M 0.6;
//@ network
	SET;
	NOT;
	= M 1.0;
	SET;
	S M 1.1;
	S M 1.2;
	R M 1.2;
	CLR;
	S M 1.3;
//@ network
	SET;
	FP M 10.0;
	= M 2.0;
	SET;
	FP M 10.0;
	= M 2.1;
	CLR;
	FN M 10.1;
	= M 2.2;
	CLR;
	FN M 10.1;
	= M 2.3;
//@ network
	SET;
	SAVE;
	CLR;
	= M 3.0;
