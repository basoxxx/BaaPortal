// Scorrimenti e rotazioni: SLW, SRW, SLD, SRD, SSI, SSD, RLD, RRD, RLDA, RRDA.
// atteso: MW0=16#2340, MW2=16#0123, MD4=16#34567800, MD8=16#00123456
// atteso: MW12=16#F800, MD14=16#FFFFFFF0, MW18=16#0080
// atteso: MD20=16#00000003, MD24=16#C0000000, MD28=2, MD32=16#80000001
//@ block OB 1
	L W#16#1234;
	SLW 4;
	T MW 0;
	L W#16#1234;
	SRW 4;
	T MW 2;
	L DW#16#12345678;
	SLD 8;
	T MD 4;
	L DW#16#12345678;
	SRD 8;
	T MD 8;
	L W#16#8000;
	SSI 4;
	T MW 12;
	L L#-256;
	SSD 4;
	T MD 14;
	L 3;
	L W#16#0010;
	SLW;
	T MW 18;
//@ network
	L DW#16#80000001;
	RLD 1;
	T MD 20;
	L DW#16#80000001;
	RRD 1;
	T MD 24;
	L DW#16#00000000;
	SLD 1;
	L DW#16#80000001;
	RLDA;
	T MD 28;
	RRDA;
	T MD 32;
