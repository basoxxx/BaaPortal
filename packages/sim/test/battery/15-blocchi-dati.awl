// Blocchi dati: OPN DB, CDB, L DBNO, L DBLG, L DINO, L DILG, accesso DBX/DBW/DBD e DIW.
// atteso: DB1.DBW0=11, DB1.DBW2=22, DB1.DBD4=100000, DB1.DBD8=16#3FC00000, DB2.DBW0=33
// atteso: MW10=2, MD12=2, MW16=2, MW18=0, MD20=12, MW24=11, MD28=12
//@ db 1 a:Int b:Int c:DWord d:Real
