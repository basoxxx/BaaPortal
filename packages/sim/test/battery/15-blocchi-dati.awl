	OPN DB 1;
	L 11;
	T DBW 0;
	L 22;
	T DBW 2;
	L L#100000;
	T DBD 4;
	L 1.5;
	T DBD 8;
	OPN DB 2;
	L 33;
	T DBW 0;
	L DBNO;
	T MW 10;
	L DBLG;
	T MD 12;
	CDB;
	L DINO;
	T MW 16;
	L DBNO;
	T MW 18;
//@ network
	OPN DI 1;
	L DILG;
	T MD 20;
	L DIW 0;
	T MW 24;
	OPN DB 1;
	L DBLG;
	T MD 28;
