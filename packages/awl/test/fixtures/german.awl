// Fixture AWL tedesca: mnemonici tedeschi (U, SPB, AUF, E/A, Z...) nelle forme di operando ammesse.
M001:	U	%E0.0;	// con etichetta
	U E 0.0
	UN A 0.1
	U %A4.7
	O M 10.7
	U E1.0
	U DB10.DBX 2.1
	U "Tag"
	UN #lokal.bit
	U Z 3
	U T 5
	U E [MD 2]
	U A [MD 2]
	U [AR1, P#0.0]
	U BIE
	O OV
	L EB 1
	L EW 0
	L ED 4
	L AB 2
	L AW 4
	L AD 4
	L PEW 256
	L PED 256
	T AW 4
	T PAW 256
	T PAD 256
	L Z 2
	L T 3
	L STW
	L DBLG
	L W [AR2, P#0.0]
	ZV Z 1
	ZR Z 2
	SI T 1
	SV T 2
	SE T 3
	SA T 5
	FR Z 1
	AUF DB 10
	AUF DI 5
	AUF DB [MW 2]
	SPA M001
	SPB M001
	SPBN M001
	BEB
	BEA
	CALL FC 1
	CALL FB 1, DB 1
	CALL "Nastro", "Nastro_DB"
	(  Start := %E0.0,
	   Fehler => %M10.0
	);
// --- una riga per ogni istruzione della tabella (mnemonico tedesco) ---
