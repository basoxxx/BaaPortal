TYPE "Dati Asse"
TITLE =
VERSION : 0.1

STRUCT
  "Velocità max" : Real := 10.5; // m/s
  "Stato asse" : Bool;
END_STRUCT;

END_TYPE

FUNCTION_BLOCK "Gestione Motore Più"
TITLE =
VERSION : 0.1

VAR_INPUT
  "Avvio più rapido" : Bool;
END_VAR

VAR
  "Asse x" : "Dati Asse";
END_VAR

BEGIN
NETWORK
TITLE = Perché
	A #"Avvio più rapido";
	= %Q0.1;
END_FUNCTION_BLOCK

DATA_BLOCK "Dati Più"
TITLE =
VERSION : 0.1

STRUCT
  "Asse x" : "Dati Asse";
END_STRUCT;

BEGIN
  "Asse x"."Velocità max" := 1.5;
END_DATA_BLOCK
