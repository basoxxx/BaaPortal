DATA_BLOCK "Dati"
TITLE = Dati di macchina
// Valori iniziali.
VERSION : 0.1

STRUCT
  Giri : Int := 5;
  Attivo : Bool;
  Asse : "Asse";
  Lista : Array[1..2] of "Asse";
  Valori : Array[1..3] of Int;
  Loc : Struct
    P : Real := 2.5;
  END_STRUCT;
END_STRUCT;

BEGIN
