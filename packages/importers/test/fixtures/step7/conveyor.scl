// Nastro trasportatore
(* Commento del blocco
   su due righe *)
FUNCTION_BLOCK "Conveyor"
TITLE = 'Comando nastro'
{ S7_m_c := 'true' }
AUTHOR : Baso
VERSION : '1.2'

CONST
  MaxSpeed := 100;
END_CONST

VAR_INPUT
  Start : BOOL;       // avvio
  Stop : BOOL := TRUE; (* arresto *)
END_VAR
VAR_OUTPUT
  Running : BOOL;
END_VAR
VAR
  Speed : INT := 10;
END_VAR

BEGIN
    // Logica
    IF Start AND NOT Stop THEN
        Running := TRUE;
    ELSIF Stop THEN
        Running := FALSE;
    END_IF;
    Speed := MaxSpeed; (* costante *)
END_FUNCTION_BLOCK

FUNCTION "Add" : INT
VAR_INPUT
  A : INT;
  B : INT;
END_VAR
BEGIN
  Add := A + B;
END_FUNCTION
