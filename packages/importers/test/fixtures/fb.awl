FUNCTION_BLOCK "Motore"
TITLE = Gestione motore
// Comanda un motore.
// Con avvio e arresto.
AUTHOR : Diego
FAMILY : Motori
NAME : Motore
VERSION : 1.0

VAR_INPUT
  Avvio : Bool; // comando di avvio
  Arresto : Bool := TRUE;
  Velocita : Int := 100;
END_VAR

VAR_OUTPUT
  Marcia : Bool;
END_VAR

VAR_IN_OUT
  Dati : "Asse";
END_VAR

VAR
  Tempo : Time := T#5s;
  Ritardo : "TON"; // multi-istanza
  Filtro : "Filtro";
END_VAR

VAR_TEMP
  Appoggio : Int;
END_VAR

BEGIN
NETWORK
TITLE = Avvio
// Parte il motore.
	A #Avvio; // start
	AN %I0.1;
	= %Q0.0;
NETWORK
TITLE = Ciclo
// Conta fino a cinque.
	L %MW10;
	L 5;
	>I;
	JC fine;
	// commento di codice
	T %MW12;
fine:	NOP 0;
END_FUNCTION_BLOCK
